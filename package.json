{
  "name": "@rednegniw/masked-view",
  "description": "React Native MaskedView component with Fabric support",
  "types": "./types/index.d.ts",
  "main": "index.js",
  "author": "Mike Nedosekin <crespo8800@gmail.com>",
  "license": "MIT",
  "version": "0.4.0",
  "homepage": "https://github.com/Rednegniw/masked-view#readme",
  "keywords": [
    "react-native",
    "react native",
    "masked-view",
    "masked view",
    "fabric"
  ],
  "codegenConfig": {
    "name": "NFMaskedViewSpec",
    "type": "components",
    "jsSrcsDir": "js",
    "android": {
      "javaPackageName": "com.numberflow.maskedview"
    },
    "ios": {
      "componentProvider": {
        "NFMaskedView": "NFMaskedViewComponentView"
      }
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "files": [
    "index.js",
    "android/src/main/java",
    "android/src/main/AndroidManifest.xml",
    "android/src/oldarch",
    "android/build.gradle",
    "ios",
    "js",
    "types",
    "react-native.config.js",
    "NFMaskedView.podspec"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rednegniw/masked-view.git"
  },
  "bugs": {
    "url": "https://github.com/Rednegniw/masked-view/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
